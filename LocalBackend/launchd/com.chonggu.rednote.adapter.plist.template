<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chonggu.rednote.adapter</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>exec '__DEPLOYED_BACKEND_DIR__/run_adapter.sh'</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>WorkingDirectory</key>
    <string>__DEPLOYED_BACKEND_DIR__</string>

    <key>StandardOutPath</key>
    <string>__DEPLOYED_BACKEND_DIR__/runtime/logs/launchd-adapter.out.log</string>

    <key>StandardErrorPath</key>
    <string>__DEPLOYED_BACKEND_DIR__/runtime/logs/launchd-adapter.err.log</string>
</dict>
</plist>
